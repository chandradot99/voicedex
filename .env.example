# Provider API keys — used by sync scripts
DEEPGRAM_API_KEY=
CARTESIA_API_KEY=
ELEVENLABS_API_KEY=
OPENAI_API_KEY=
GOOGLE_CLOUD_API_KEY=          # Text-to-Speech voices (key restricted to the TTS API)
# Optional: Speech-to-Text v2 Locations API (per-region STT models). Rejects API keys — run
# `gcloud auth application-default login` once; the sync script uses those credentials.
GOOGLE_CLOUD_PROJECT=
SARVAM_API_KEY=
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=eastus
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
HUME_API_KEY=
INWORLD_API_KEY=
MURF_API_KEY=
SPEECHMATICS_API_KEY=
LMNT_API_KEY=
ASSEMBLYAI_API_KEY=
REVAI_API_KEY=
GLADIA_API_KEY=
MINIMAX_API_KEY=
IBM_TTS_API_KEY=
IBM_STT_API_KEY=
# Instance URLs from each service's Manage page (…/instances/<id>) — a bare regional URL returns 403
IBM_TTS_URL=https://api.us-south.text-to-speech.watson.cloud.ibm.com/instances/<id>
IBM_STT_URL=https://api.us-south.speech-to-text.watson.cloud.ibm.com/instances/<id>
NEUPHONIC_API_KEY=
RESEMBLE_API_KEY=
FISH_AUDIO_API_KEY=
UNREAL_SPEECH_API_KEY=
SMALLEST_API_KEY=
LOVO_API_KEY=
MISTRAL_API_KEY=
WELLSAID_API_KEY=
CAMBAI_API_KEY=
SPEECHIFY_API_KEY=
TYPECAST_API_KEY=
GROQ_API_KEY=
SONIOX_API_KEY=
XAI_API_KEY=
GRADIUM_API_KEY=
# Alibaba Cloud Model Studio, Singapore (international) region — keys only work in their own region
DASHSCOPE_API_KEY=
DASHSCOPE_WORKSPACE_ID=
ASYNC_API_KEY=

# ── Expansion 2026-11: key-gated lists (each provider syncs docs-only until its key is set) ──
# CoeFont: voice list GET /v2/coefonts/pro (HMAC access key + secret)
COEFONT_ACCESS_KEY=
COEFONT_ACCESS_SECRET=
# KugelAudio: voice list GET /v1/voices
KUGELAUDIO_API_KEY=
# Munsit: voice list GET /api/v1/voices
MUNSIT_API_KEY=
# Zyphra: default voices
ZYPHRA_API_KEY=
# Respeecher: Space + Marketplace voice lists
RESPEECHER_API_KEY=
# Respeecher Voice Marketplace (separate key, generated at marketplace.respeecher.com/account)
RESPEECHER_MARKETPLACE_API_KEY=
# Tilde: ASR/TTS system ids (GET /asr/systems, /tts/systems) — provider not added until then
TILDE_API_KEY=
# Bhashini: ULCA integrator credentials for the pipeline search/config API
BHASHINI_USER_ID=
BHASHINI_ULCA_API_KEY=

# Optional. Leave empty when syncing with Claude Code: it extracts docs into .sync-cache/ itself.
# Only used on a cache miss (e.g. the admin server). Cache always takes precedence.
ANTHROPIC_API_KEY=

# Deployment (web app)
# SITE_URL=https://voicedex.dev          # canonical origin for links, sitemap, share previews
# TRUST_CF_CONNECTING_IP=false            # true only when all traffic comes through Cloudflare's proxy
