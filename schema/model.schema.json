          "default": null,
          "title": "Conditions"
        },
        "metric": {
          "title": "Metric",
          "type": "string"
        },
        "ms": {
          "exclusiveMinimum": 0,
          "title": "Ms",
          "type": "number"
        },
        "qualifier": {
          "default": "typical",
          "title": "Qualifier",
          "type": "string"
        },
        "source_url": {
          "title": "Source Url",
          "type": "string"
