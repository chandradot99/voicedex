    "LatencyClaim": {
      "additionalProperties": false,
      "description": "A latency figure from the vendor's own pages, shown as the vendor's claim.",
      "properties": {
        "as_of": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "As Of"
