    "Pricing": {
      "additionalProperties": false,
      "description": "List price as published. USD → `price_usd`. Other currencies → `price` + `currency` (ISO 4217),\nnever converted (FX would be a guess); `price_usd` stays null for them.",
      "properties": {
        "as_of": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "As Of"
        },
        "currency": {
