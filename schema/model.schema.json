          "default": null,
          "title": "Source Url"
        },
        "unit": {
          "title": "Unit",
          "type": "string"
        },
        "variants": {
          "items": {
            "$ref": "#/$defs/PriceVariant"
          },
          "title": "Variants",
          "type": "array"
        }
      },
      "required": [
        "unit"
      ],
      "title": "Pricing",
      "type": "object"
    },
